# Postgres connection string. Required — the app has no other data store.
#
# Local:  docker run -d --name opencasting-db -p 5432:5432 \
#           -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=opencasting postgres:16
#         DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opencasting"
#
# Hosted (Neon, Supabase, Vercel Postgres): use the POOLED connection string,
# not the direct one — serverless opens a connection per instance.
DATABASE_URL="postgresql://user:password@host:5432/opencasting?sslmode=require"

# Optional. Connections per instance; keep it low on serverless. Defaults to 5.
# DATABASE_POOL_MAX=5
