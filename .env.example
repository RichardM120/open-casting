# ---------------------------------------------------------------- database --
# Postgres connection string. Required: the app has no other data store.
#
# Local:  docker run -d --name opencasting-db -p 5432:5432 \
#           -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=opencasting postgres:16
#         DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opencasting"
#
# Hosted (Neon, Supabase, Vercel Postgres): use the POOLED connection string,
# not the direct one, because serverless opens a connection per instance.
#
# If a hosted integration provisions POSTGRES_URL, POSTGRES_PRISMA_URL or
# POSTGRES_URL_NON_POOLING instead, the app reads those too, in that order.
DATABASE_URL="postgresql://user:password@host:5432/opencasting?sslmode=require"

# Optional. Connections per instance; keep it low on serverless. Defaults to 5.
# DATABASE_POOL_MAX=5

# Optional. Set to 1 only for a provider using its own certificate authority.
# The connection stays encrypted but the server certificate is not verified.
# DATABASE_SSL_NO_VERIFY=1

# ---------------------------------------------------------------- prelaunch --
# One passcode for the whole site, pre-launch. With this set, every page shows
# an interstitial asking for it and nothing behind it is served: not the
# sign-in page, not a casting share link. Only the interstitial, /api/health
# and robots.txt answer through it.
#
# Behind the wall, sign-in stops checking anything: any email and any password
# gets a session, and an account is created on the spot for an address that has
# none. Google sign-in is withdrawn, being the one way in that authenticates.
#
# The two are the same switch on purpose. Sign-in that checks nothing is only
# safe because the wall means nobody uncontrolled reaches it.
#
# A banner appears on every page while it is set, and /api/health reports it.
# Unset it to launch: everything reverts to real sign-in with no code change.
#
# Needs AUTH_SECRET (below) too: the passcode is remembered in a signed cookie,
# and without the key the wall is up and nothing can open it.
# SITE_PASSCODE="something-you-can-say-down-a-phone"

# -------------------------------------------------------------------- auth --
# REQUIRED. Signs the context cookie the proxy reads to check a role at the
# edge, where there is no database. At least 32 characters, and secret: anyone
# who knows it can mint a cookie claiming to be an admin.
#
#   openssl rand -base64 32
#
# Without it nobody can sign in, and /api/health reports it as missing.
AUTH_SECRET="change-me-to-at-least-32-random-characters"

# ------------------------------------------------------------------ email --
# Needed for the second factor: an admin signs in with a password and then a
# one-time link, and without a mail provider that link cannot be sent, so
# nobody can sign in to an admin account at all. Get a key at resend.com.
#
# With no key set, the link is written to the server log in development only,
# never in production.
# RESEND_API_KEY="re_..."
#
# Must be a domain you have verified with the provider. Defaults to Resend's
# shared onboarding sender, which is fine for a first test and not for real use.
# EMAIL_FROM="Open Casting <casting@your-domain>"

# ------------------------------------------------------------------ access --
# Comma-separated addresses granted the admin role. Nobody can register
# themselves, and admin cannot be chosen. This is the only way to grant it.
# Checked on every sign-in, so removing an address here demotes that account.
# Comma-separated, so more than one address can hold admin.
# ADMIN_EMAILS="richard@seaglassdigital.co.uk,richard@cwcasting.co.uk"

# Creates the FIRST address in ADMIN_EMAILS as an account, once, if it does not
# already exist. Without it a fresh deployment has no way in at all, because
# there is no sign-up page. It is ignored once the account exists, so changing
# it here does not change the password. Do that in the app.
# ADMIN_BOOTSTRAP_PASSWORD="three-random-words-and-a-number"

# Optional. Lets you sign in as the seeded demo account (demo@opencasting.app)
# to see a populated dashboard. Without it the account exists but its password
# is random. The sample productions are reachable either way, by their share
# links. They are demo data with fixed, deliberately guessable tokens.
# DEMO_PASSWORD="something long"

# --------------------------------------------------------------- retention --
# Required for the scheduled retention sweep at /api/retention, which deletes
# performers' details thirty days after a production ends. Without it the
# endpoint refuses to run: an open delete endpoint is worse than an unscheduled
# sweep. Vercel Cron sends it as "Authorization: Bearer <value>".
#
# The same sweep also runs once per process on boot, so retention is honoured
# even if the cron is never configured.
# CRON_SECRET="a long random string"

# ----------------------------------------------------- google sign-in (opt) --
# Leave unset and the Google buttons are simply not shown; password sign-in
# still works. An address in ADMIN_EMAILS can sign in with Google without an
# account existing first. That is the only address Google sign-in will create
# one for. To enable, create an OAuth 2.0 Client ID (type: Web application)
# in the Google Cloud Console and register these redirect URIs:
#
#   https://your-domain/api/auth/google/callback
#   https://your-preview.vercel.app/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
#
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."

# The canonical origin. Pins two things: the redirect URI sent to Google, and
# the share links a casting director copies, so a link always points at one
# host and a performer never pays a redirect, whichever of your domains the
# link was copied from. Leave unset on previews, where the request's own origin
# is what you want.
# APP_URL="https://opencasting.app"

# ------------------------------------------------------------------ media --
# Applicants can attach a profile photo and a video to a submission. The files
# go straight from the browser into Vercel Blob (Storage -> Blob in the Vercel
# dashboard), which sets this. Without it the form offers no uploads, and
# everything else works as before. Files are private and are deleted with the
# submission they belong to.
# If a prefix was chosen when the store was connected, the variable is
# <PREFIX>_READ_WRITE_TOKEN instead; the app accepts either.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --------------------------------------------------------------- the company --
# Who the operator is. The Companies (Trading Disclosures) Regulations 2008
# want a limited company's registered name, its number, where it is registered
# and its registered office shown on its website. The name has a default; each
# of the rest appears in the footer only once it is set, so a missing one is a
# gap rather than an invented address.
#
# ICO_REGISTRATION is the data protection fee registration. A controller that
# has paid it should say so: an applicant handing over a headshot can then
# check who is asking on the ICO's own register. VAT_NUMBER is shown where the
# company trades once it is VAT registered.
# COMPANY_NAME="CW Casting Limited"
# COMPANY_NUMBER="12345678"
# REGISTERED_OFFICE="1 Example Street, Leeds LS1 1AA"
# VAT_NUMBER="GB123456789"
# ICO_REGISTRATION="ZB123456"

# Where an applicant reports a casting call that is not what it says it is, or
# anyone asking them for a fee. Falls back to the first address in
# ADMIN_EMAILS. Check it: this one is printed on every public page, and a
# mistyped address is a report nobody receives.
# REPORT_EMAIL="report@opencasting.app"
